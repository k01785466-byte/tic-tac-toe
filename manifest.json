function getIconUrl(emoji) {
  return ICON_MAP[emoji] || 'https://raw.githubusercontent.com/microsoft/fluentui-emoji/main/assets/Gem%20stone/3D/gem_stone_3d.png';
}

const state = {
  playerId: localStorage.getItem('kasino_player_id') || 'player_' + Math.random().toString(36).substr(2, 9),
  balance: parseFloat(localStorage.getItem('ks_balance')) || 1000,
  bet: 100,
  avatar: localStorage.getItem('ks_avatar') || '',
  nickname: localStorage.getItem('ks_nickname') || 'Игрок',
  stats: JSON.parse(localStorage.getItem('ks_stats')) || { spins: 0, won: 0, maxWin: 0, totalBet: 0 }
};
localStorage.setItem('kasino_player_id', state.playerId);

let currentMachine = null, isSpinning = false;

window.showPage = (id) => {
  document.querySelectorAll('.page-view').forEach(el => el.classList.remove('active'));
  const el = document.getElementById('page-' + id);
  if (el) el.classList.add('active');

  if (id === 'profile') renderProfileStats();
  if (id === 'edit-profile') document.getElementById('input-nick').value = state.nickname;
};

function saveToLocal() {
  localStorage.setItem('ks_balance', state.balance);
  localStorage.setItem('ks_nickname', state.nickname);
  localStorage.setItem('ks_stats', JSON.stringify(state.stats));
  localStorage.setItem('ks_avatar', state.avatar);
}

function updateUI() {
  const fmt = Math.floor(state.balance).toLocaleString('ru-RU') + ' ₽';
  document.getElementById('ui-balance').textContent = fmt;
  document.getElementById('game-balance').textContent = fmt;
  const betInput = document.getElementById('game-bet');
  if (betInput && document.activeElement !== betInput) betInput.value = state.bet;
}

function updateProfileUI() {
  const defaultAvatar = 'https://raw.githubusercontent.com/microsoft/fluentui-emoji/main/assets/Smiling%20face%20with%20sunglasses/3D/smiling_face_with_sunglasses_3d.png';
  const currentAvatar = state.avatar || defaultAvatar;
  
  document.getElementById('profile-big-avatar').src = currentAvatar;
  document.getElementById('nav-avatar').src = currentAvatar;
  
  document.getElementById('profile-big-nick').textContent = state.nickname;
  document.getElementById('profile-big-id').textContent = `ID: #${state.playerId.slice(-4).toUpperCase()}`;
}

function renderProfileStats() {
  document.getElementById('stat-spins').textContent = (state.stats.spins || 0).toLocaleString('ru-RU');
  document.getElementById('stat-bet').textContent = Math.floor(state.stats.totalBet || 0).toLocaleString('ru-RU') + ' ₽';
  document.getElementById('stat-won').textContent = Math.floor(state.stats.won || 0).toLocaleString('ru-RU') + ' ₽';
  document.getElementById('stat-maxwin').textContent = Math.floor(state.stats.maxWin || 0).toLocaleString('ru-RU') + ' ₽';
  document.getElementById('stat-balance').textContent = Math.floor(state.balance).toLocaleString('ru-RU') + ' ₽';
  
  const profit = (state.stats.won || 0) - (state.stats.totalBet || 0);
  const profitEl = document.getElementById('stat-profit');
  profitEl.textContent = (profit >= 0 ? '+' : '') + Math.floor(profit).toLocaleString('ru-RU') + ' ₽';
  profitEl.style.color = profit >= 0 ? 'var(--accent-green)' : 'var(--accent-red)';
}

function renderLobby() {
  const grid = document.getElementById('machine-grid');
  grid.innerHTML = MACHINES.map(m => `
    <div class="game-card" onclick="openMachine('${m.id}')">
      <img src="${getIconUrl(m.symbols[0])}" class="game-icon">
      <div class="game-title">${m.name}</div>
      <div class="game-desc">${m.desc}</div>
      <button class="play-btn">Играть</button>
    </div>
  `).join('');
}

window.saveProfile = () => {
  const v = document.getElementById('input-nick').value.trim();
  if (v) { state.nickname = v; saveToLocal(); updateProfileUI(); updateUI(); }
  showPage('profile');
};

document.getElementById('upload-avatar').addEventListener('change', (e) => {
  const f = e.target.files[0]; if (!f) return;
  const rd = new FileReader();
  rd.onload = (ev) => { state.avatar = ev.target.result; saveToLocal(); updateProfileUI(); };
  rd.readAsDataURL(f);
});

window.openMachine = (id) => {
  currentMachine = MACHINES.find(m => m.id === id);
  if (!currentMachine) return;
  
  for (let col = 0; col < 3; col++) {
    const strip = document.getElementById('reel-' + col);
    strip.style.transition = 'none';
    strip.style.transform = 'translateY(0)';
    strip.innerHTML = '';
    for (let row = 0; row < 3; row++) {
      const symbol = currentMachine.symbols[(col + row) % currentMachine.symbols.length];
      strip.innerHTML += `<div class="reel-item"><img src="${getIconUrl(symbol)}"></div>`;
    }
  }
  document.getElementById('game-screen').classList.add('active');
  document.body.style.overflow = 'hidden';
  updateUI();
};

window.closeMachine = () => {
  document.getElementById('game-screen').classList.remove('active');
  document.body.style.overflow = '';
  currentMachine = null;
  updateUI();
};

window.changeBet = (amt) => {
  if (isSpinning) return;
  state.bet = Math.max(10, Math.min(state.balance, state.bet + amt, 50000));
  document.getElementById('game-bet').value = state.bet;
};

window.maxBet = () => {
  if (isSpinning) return;
  state.bet = Math.min(state.balance, 50000);
  if (state.bet < 10) state.bet = 10;
  document.getElementById('game-bet').value = state.bet;
};

const WIN_LINES = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];

function generateResult(syms) {
  let result = Array.from({ length: 9 }, () => syms[Math.floor(Math.random() * syms.length)]);
  const hasAnyTriple = WIN_LINES.some(l => result[l[0]] === result[l[1]] && result[l[1]] === result[l[2]]);
  if (hasAnyTriple) return result;
  if (Math.random() < 0.15) {
    const line = WIN_LINES[Math.floor(Math.random() * WIN_LINES.length)];
    const s = syms[Math.floor(Math.random() * syms.length)];
    line.forEach(idx => result[idx] = s);
  }
  return result;
}

window.spin = () => {
  if (isSpinning || !currentMachine) return;
  if (state.balance < state.bet) { alert('Мало средств!'); return; }

  isSpinning = true;
  document.getElementById('btn-spin').disabled = true;
  
  state.balance -= state.bet;
  state.stats.spins++;
  state.stats.totalBet += state.bet;
  saveToLocal(); updateUI();
  document.querySelectorAll('.reel-item').forEach(el => el.classList.remove('winning'));

  const syms = currentMachine.symbols;
  const result = generateResult(syms);
  const reelHeight = document.querySelector('.reel-window').offsetHeight / 3;
  const ITEMS = 20;
  const DURATION = 1500;

  for (let col = 0; col < 3; col++) {
    const strip = document.getElementById('reel-' + col);
    let html = '';
    for (let k = 0; k < ITEMS; k++) html += `<div class="reel-item"><img src="${getIconUrl(syms[Math.floor(Math.random() * syms.length)])}"></div>`;
    html += `<div class="reel-item"><img src="${getIconUrl(result[col])}"></div>`;
    html += `<div class="reel-item"><img src="${getIconUrl(result[col + 3])}"></div>`;
    html += `<div class="reel-item"><img src="${getIconUrl(result[col + 6])}"></div>`;
    strip.innerHTML = html;
    strip.style.transition = 'none';
    strip.style.transform = 'translateY(0)';
  }

  void document.body.offsetHeight;

  for (let col = 0; col < 3; col++) {
    const strip = document.getElementById('reel-' + col);
    strip.style.transition = `transform ${DURATION}ms cubic-bezier(0.1, 0.7, 0.1, 1) ${col * 200}ms`;
    strip.style.transform = `translateY(-${ITEMS * reelHeight}px)`;
  }

  setTimeout(() => { checkWin(result); }, DURATION + 400 + 100);
};

function checkWin(res) {
  let win = 0;
  const syms = currentMachine.symbols;
  let winningCells = new Set();

  WIN_LINES.forEach(l => {
    if (res[l[0]] === res[l[1]] && res[l[1]] === res[l[2]]) {
      win += state.bet * currentMachine.triple[syms.indexOf(res[l[0]])];
      l.forEach(idx => winningCells.add(idx));
    }
  });

  win = Math.floor(win);

  if (win > 0) {
    winningCells.forEach(idx => {
      const col = idx % 3, row = Math.floor(idx / 3);
      const strip = document.getElementById('reel-' + col);
      const items = strip.querySelectorAll('.reel-item');
      const targetItem = items[items.length - 3 + row];
      if (targetItem) targetItem.classList.add('winning');
    });

    state.balance += win;
    state.stats.won += win;
    if (win > state.stats.maxWin) state.stats.maxWin = win;
    saveToLocal(); updateUI();
    
    // Минималистичный показ выигрыша
    document.getElementById('win-title').textContent = 'Выигрыш';
    document.getElementById('win-amount').textContent = win.toLocaleString('ru-RU') + ' ₽';
    document.getElementById('win-popup').classList.add('active');
    setTimeout(() => document.getElementById('win-popup').classList.remove('active'), 2000);
  }

  isSpinning = false;
  document.getElementById('btn-spin').disabled = false;
}

// Инициализация
renderLobby();
updateUI();
updateProfileUI();
</script>
</body>
</html>
