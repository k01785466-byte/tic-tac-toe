<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>Kesug Slots</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='0' fill='%23000'/%3E%3Cpath d='M32 12 L52 32 L32 52 L12 32 Z' fill='%2334c759'/%3E%3C/svg%3E">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<script src="https://unpkg.com/@phosphor-icons/web"></script>
<style>
:root {
  --bg-main: #000000;
  --bg-card: #0a0a0a;
  --bg-surface: #1c1c1e;
  --text-primary: #f5f5f7;
  --text-secondary: #86868b;
  --border-light: rgba(255, 255, 255, 0.1);
  --accent-green: #34c759;
  --accent-red: #ff3b30;
  --reel-h: 100px;
}

* { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; user-select: none; -webkit-tap-highlight-color: transparent; letter-spacing: -0.02em; }
::-webkit-scrollbar { display: none; }
body { 
  color: var(--text-primary); font-size: 15px; line-height: 1.5; overflow-x: hidden; min-height: 100vh; 
  background-color: var(--bg-main); padding-top: 100px; 
}

/* ═══════ МИНИМАЛИСТИЧНАЯ ШАПКА ═══════ */
.top-header { 
  position: fixed; top: 0; left: 0; width: 100%; height: 80px; z-index: 1000; 
  background: rgba(0, 0, 0, 0.8); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border-light);
}
.header-inner { max-width: 900px; margin: 0 auto; height: 100%; padding: 0 20px; display: flex; justify-content: space-between; align-items: center; }
.top-brand { display: flex; align-items: center; gap: 8px; font-size: 18px; font-weight: 600; color: var(--text-primary); cursor: pointer; }
.top-brand i { color: var(--accent-green); font-size: 22px; }

.user-balance { 
  display: flex; align-items: center; gap: 8px; font-size: 16px; font-weight: 500; color: var(--text-primary);
}
.user-balance img { width: 20px; opacity: 0.8; }

.profile-btn { 
  background: var(--bg-surface); border: 1px solid var(--border-light); width: 40px; height: 40px; border-radius: 50%; 
  cursor: pointer; display: flex; justify-content: center; align-items: center; transition: 0.2s; padding: 0;
}
.profile-btn:hover { background: #2c2c2e; }
.profile-btn img { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; }

/* ═══════ КОНТЕНТ ═══════ */
.content-wrapper { width: 100%; max-width: 900px; margin: 0 auto; padding: 30px 20px 60px 20px; }

/* СЕТКА ИГР */
.games-grid { 
  display: grid; 
  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); 
  gap: 20px; 
}
.game-card { 
  background: var(--bg-card); border: 1px solid var(--border-light); 
  padding: 25px 15px; text-align: center; cursor: pointer; border-radius: 16px; 
  display: flex; flex-direction: column; align-items: center; transition: 0.2s;
}
.game-card:hover { border-color: var(--text-secondary); background: var(--bg-surface); }
.game-icon { width: 60px; height: 60px; margin-bottom: 15px; object-fit: contain; }
.game-title { font-size: 14px; font-weight: 500; color: var(--text-primary); margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%; }
.game-desc { font-size: 12px; color: var(--text-secondary); margin-bottom: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%; }
.play-btn { background: transparent; border: none; color: var(--accent-green); padding: 8px; font-size: 13px; font-weight: 500; width: 100%; transition: 0.2s; }
.game-card:hover .play-btn { color: #2cd64d; }

/* ПРОФИЛЬ */
.page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 30px; }
.back-btn { background: transparent; border: none; color: var(--text-secondary); font-size: 14px; font-weight: 500; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; padding: 8px 0; transition: 0.2s; }
.back-btn:hover { color: var(--text-primary); }

.profile-card { display: flex; align-items: center; gap: 20px; background: var(--bg-card); border: 1px solid var(--border-light); padding: 25px; border-radius: 20px; margin-bottom: 30px; }
.profile-avatar { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; background: #000; }
.profile-info h2 { color: var(--text-primary); font-size: 22px; font-weight: 600; margin-bottom: 4px; }
.profile-info p { color: var(--text-secondary); font-size: 14px; }
.btn { padding: 14px 20px; font-weight: 500; font-size: 14px; cursor: pointer; border: none; display: inline-flex; align-items: center; justify-content: center; gap: 8px; border-radius: 12px; transition: 0.2s; }
.btn-green { background: var(--accent-green); color: #000; width: 100%; }
.btn-green:hover { background: #40d360; }
.btn-gray { background: var(--bg-surface); color: var(--text-primary); border: 1px solid var(--border-light); }
.btn-gray:hover { background: #2c2c2e; }

/* СТАТИСТИКА */
.stat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 15px; }
.stat-card { background: var(--bg-card); border: 1px solid var(--border-light); padding: 20px 15px; text-align: center; border-radius: 16px; }
.stat-icon { font-size: 24px; color: var(--text-secondary); margin-bottom: 10px; display: block; }
.stat-value { font-size: 16px; font-weight: 600; color: var(--text-primary); margin-bottom: 4px; }
.stat-label { font-size: 11px; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; }

/* ФОРМА */
.form-box { background: var(--bg-card); padding: 25px; border-radius: 20px; border: 1px solid var(--border-light); margin-bottom: 25px; }
.form-label { font-size: 12px; color: var(--text-secondary); font-weight: 500; text-transform: uppercase; margin-bottom: 10px; display: block; }
.inp { width: 100%; padding: 16px; background: #000; border: 1px solid var(--border-light); color: var(--text-primary); font-size: 15px; outline: none; border-radius: 12px; margin-bottom: 20px; transition: 0.2s; }
.inp:focus { border-color: var(--text-secondary); }
.btn-row { display: flex; gap: 12px; }

/* ═══════ ИГРОВОЙ ЭКРАН (3D ЭФФЕКТ) ═══════ */
#game-screen { 
  position: fixed; inset: 0; background: var(--bg-main); z-index: 9999; 
  display: none; flex-direction: column; align-items: center; justify-content: center; padding: 20px; 
  perspective: 1200px; /* Включаем 3D-перспективу */
}
#game-screen.active { display: flex; }

.game-header { position: absolute; top: 0; left: 0; width: 100%; height: 80px; background: rgba(0, 0, 0, 0.8); backdrop-filter: blur(20px); border-bottom: 1px solid var(--border-light); display: flex; justify-content: space-between; align-items: center; padding: 0 20px; }
.back-btn-game { background: transparent; border: none; color: var(--text-secondary); font-size: 14px; font-weight: 500; cursor: pointer; display: flex; align-items: center; gap: 6px; padding: 8px; }
.back-btn-game:hover { color: var(--text-primary); }

/* Объемный контейнер для слотов */
.slot-container { 
  background: var(--bg-card); border: 1px solid var(--border-light); padding: 30px; width: 100%; max-width: 440px; border-radius: 24px; 
  transform: rotateX(5deg); /* Легкий наклон для 3D-эффекта */
  box-shadow: 0 30px 60px rgba(0,0,0,0.8), inset 0 1px 0 rgba(255,255,255,0.1);
  transform-style: preserve-3d;
}
.reels { 
  background: #000; padding: 15px; border: 1px solid var(--border-light); display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 25px; 
  border-radius: 16px; position: relative; transform: translateZ(20px); /* Выдвигаем барабаны вперед */
  box-shadow: inset 0 10px 20px rgba(0,0,0,1), inset 0 -10px 20px rgba(0,0,0,1);
}
.reel-window { height: calc(var(--reel-h) * 3); background: #050505; position: relative; overflow: hidden; border-radius: 8px; }
.reel-strip { position: absolute; top: 0; left: 0; width: 100%; display: flex; flex-direction: column; align-items: center; }
.reel-item { height: var(--reel-h); width: 100%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.reel-item img { width: 80%; height: 80%; object-fit: contain; }
.reel-item.winning { background: rgba(52, 199, 89, 0.15); border-radius: 8px; }

.game-controls { display: flex; flex-direction: column; gap: 15px; transform: translateZ(10px); }
.bet-box { display: flex; align-items: center; justify-content: space-between; background: #000; padding: 15px 20px; border-radius: 16px; border: 1px solid var(--border-light); }
.bet-box span { color: var(--text-secondary); font-weight: 500; }
.bet-box input { width: 100px; background: transparent; border: none; color: var(--text-primary); font-size: 20px; text-align: right; font-weight: 600; outline: none; }
.bet-btns { display: flex; gap: 10px; }
.bet-btns button { flex: 1; background: var(--bg-surface); border: 1px solid var(--border-light); color: var(--text-primary); padding: 14px; cursor: pointer; font-weight: 500; border-radius: 12px; transition: 0.2s; }
.bet-btns button:hover { background: #2c2c2e; }
.spin-btn-big { background: var(--accent-green); color: #000; border: none; padding: 20px; font-size: 18px; font-weight: 600; cursor: pointer; border-radius: 16px; width: 100%; transition: 0.2s; }
.spin-btn-big:hover { background: #40d360; }
.spin-btn-big:disabled { background: var(--bg-surface); color: var(--text-secondary); cursor: not-allowed; }

/* ═══════ МИНИМАЛИСТИЧНЫЙ ПОПАП ═══════ */
.win-popup { position: fixed; inset: 0; z-index: 10005; display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.3s; background: rgba(0,0,0,0.8); backdrop-filter: blur(10px); }
.win-popup.active { opacity: 1; pointer-events: auto; }
.win-box { 
  background: var(--bg-card); border: 1px solid var(--border-light); width: 90%; max-width: 320px; text-align: center; 
  border-radius: 24px; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.6); transform: scale(0.95); transition: 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); 
}
.win-popup.active .win-box { transform: scale(1); }
.win-title { color: var(--text-secondary); font-weight: 500; padding: 25px 20px 10px 20px; font-size: 14px; text-transform: uppercase; letter-spacing: 0.1em; }
.win-amount { padding: 0 20px 30px 20px; font-size: 48px; font-weight: 600; color: var(--accent-green); letter-spacing: -0.03em; }

/* СТРАНИЦЫ */
.page-view { display: none; }
.page-view.active { display: block; }

/* АДАПТИВ */
@media (max-width: 480px) {
  :root { --reel-h: 75px; }
  body { padding-top: 80px; }
  .top-brand { font-size: 16px; }
  .user-balance { font-size: 14px; }
  .profile-btn { width: 36px; height: 36px; }
  .profile-btn img { width: 28px; height: 28px; }
  .profile-card { flex-direction: column; text-align: center; padding: 20px; }
  .slot-container { padding: 20px; border-radius: 20px; transform: rotateX(3deg); } /* Меньше наклон на телефонах */
  .reels { gap: 6px; padding: 8px; }
  .game-header { height: 70px; }
}
</style>
</head>
<body>

<!-- ШАПКА -->
<div class="top-header">
  <div class="header-inner">
    <div class="top-brand" onclick="showPage('lobby')">
      <i class="ph-bold ph-diamonds-four"></i> Kesug Slots
    </div>
    <div style="display: flex; align-items: center; gap: 20px;">
      <div class="user-balance" id="ui-balance-wrap">
        <img src="https://raw.githubusercontent.com/microsoft/fluentui-emoji/main/assets/Money%20bag/3D/money_bag_3d.png" alt="Wallet">
        <span id="ui-balance">0 ₽</span>
      </div>
      <button class="profile-btn" onclick="showPage('profile')">
        <img id="nav-avatar" src="https://raw.githubusercontent.com/microsoft/fluentui-emoji/main/assets/Smiling%20face%20with%20sunglasses/3D/smiling_face_with_sunglasses_3d.png">
      </button>
    </div>
  </div>
</div>

<div class="content-wrapper">
  <main>
    <!-- ЛОББИ -->
    <div class="page-view active" id="page-lobby">
      <div class="games-grid" id="machine-grid"></div>
    </div>

    <!-- ПРОФИЛЬ -->
    <div class="page-view" id="page-profile">
      <div class="page-header">
        <button class="back-btn" onclick="showPage('lobby')"><i class="ph-bold ph-arrow-left"></i> На главную</button>
      </div>
      
      <div class="profile-card">
        <img id="profile-big-avatar" class="profile-avatar" src="">
        <div class="profile-info">
          <h2 id="profile-big-nick">Игрок</h2>
          <p id="profile-big-id">ID: #0000</p>
        </div>
      </div>
      
      <button class="btn btn-green" onclick="showPage('edit-profile')" style="margin-bottom: 30px;"><i class="ph-bold ph-pencil"></i> Редактировать</button>

      <div class="stat-grid">
        <div class="stat-card"><i class="ph-bold ph-arrows-clockwise stat-icon"></i><div class="stat-value" id="stat-spins">0</div><div class="stat-label">Спинов</div></div>
        <div class="stat-card"><i class="ph-bold ph-coins stat-icon"></i><div class="stat-value" id="stat-bet">0 ₽</div><div class="stat-label">Ставок</div></div>
        <div class="stat-card"><i class="ph-bold ph-trophy stat-icon"></i><div class="stat-value" id="stat-won">0 ₽</div><div class="stat-label">Выиграно</div></div>
        <div class="stat-card"><i class="ph-bold ph-trend-up stat-icon"></i><div class="stat-value" id="stat-maxwin">0 ₽</div><div class="stat-label">Макс. выигрыш</div></div>
        <div class="stat-card"><i class="ph-bold ph-wallet stat-icon"></i><div class="stat-value" id="stat-balance">0 ₽</div><div class="stat-label">Баланс</div></div>
        <div class="stat-card"><i class="ph-bold ph-arrows-down-up stat-icon"></i><div class="stat-value" id="stat-profit">0 ₽</div><div class="stat-label">Прибыль</div></div>
      </div>
    </div>

    <!-- РЕДАКТИРОВАНИЕ -->
    <div class="page-view" id="page-edit-profile">
      <div class="page-header">
        <button class="back-btn" onclick="showPage('profile')"><i class="ph-bold ph-arrow-left"></i> Назад</button>
      </div>
      
      <div class="form-box">
        <label class="form-label">Никнейм</label>
        <input type="text" id="input-nick" class="inp" maxlength="15">
        
        <label class="form-label">Аватар</label>
        <button class="btn btn-gray" onclick="document.getElementById('upload-avatar').click()" style="width: 100%;"><i class="ph-bold ph-image"></i> Загрузить</button>
        <input type="file" id="upload-avatar" accept="image/*" style="display:none">
      </div>
      
      <div class="btn-row">
        <button class="btn btn-green" onclick="saveProfile()">Сохранить</button>
        <button class="btn btn-gray" onclick="showPage('profile')">Отмена</button>
      </div>
    </div>
  </main>
</div>

<!-- ИГРОВОЙ ЭКРАН -->
<div id="game-screen">
  <div class="game-header">
    <button class="back-btn-game" onclick="closeMachine()"><i class="ph-bold ph-arrow-left"></i> Назад</button>
    <div class="user-balance" style="font-size: 15px;">
      <img src="https://raw.githubusercontent.com/microsoft/fluentui-emoji/main/assets/Money%20bag/3D/money_bag_3d.png" alt="Wallet" style="width: 18px;">
      <span id="game-balance">1000 ₽</span>
    </div>
  </div>

  <div class="slot-container">
    <div class="reels" id="main-reels">
      <div class="reel-window"><div class="reel-strip" id="reel-0"></div></div>
      <div class="reel-window"><div class="reel-strip" id="reel-1"></div></div>
      <div class="reel-window"><div class="reel-strip" id="reel-2"></div></div>
    </div>

    <div class="game-controls">
      <div class="bet-box">
        <span>Ставка</span>
        <input type="number" id="game-bet" value="100" min="10" max="50000">
      </div>
      <div class="bet-btns">
        <button onclick="changeBet(-50)">-50</button>
        <button onclick="changeBet(50)">+50</button>
        <button onclick="maxBet()">MAX</button>
      </div>
      <button class="spin-btn-big" id="btn-spin" onclick="spin()">Крутить</button>
    </div>
  </div>
</div>

<!-- ПОПАП ВЫИГРЫША -->
<div class="win-popup" id="win-popup">
  <div class="win-box">
    <div class="win-title" id="win-title">Выигрыш</div>
    <div class="win-amount" id="win-amount">0 ₽</div>
  </div>
</div>

