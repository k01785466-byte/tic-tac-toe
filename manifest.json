  { id: 'divinefortune', name: 'Divine Fortune', desc: 'NetEnt', symbols: ['🦉','⚡','🏛️','👑','💎','🏆'], triple: [2,4,6,12,20,40] },
  { id: 'deadordealive', name: 'Dead or Alive', desc: 'NetEnt', symbols: ['🤠','🔫','💰','🐍','🦂','💀'], triple: [2,4,8,15,30,60] },
  { id: 'jackbeanstalk', name: 'Jack & Beanstalk', desc: 'NetEnt', symbols: ['🌱','🌰','🐄','🪓','💰','👑'], triple: [2,3,5,10,15,25] },
